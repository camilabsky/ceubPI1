# Required by the backend to sign authentication sessions.
JWT_SECRET=

# MySQL settings. The in-network MySQL port is 3306.
DB_HOST=db
DB_PORT=3306
DB_NAME=horta
DB_USER=user
DB_PASSWORD=

# Password recovery email (SMTP). Recovery stays disabled until all are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Public app URL; production must use HTTPS. Local development may use localhost.
PASSWORD_RESET_URL=http://localhost:3000/
