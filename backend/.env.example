# Porta local do servidor HTTP Express (opcional, padrão 3001)
PORT=3001

# Segredo usado pelo backend para assinar e validar tokens JWT de sessão
JWT_SECRET=

# Configurações de conexão com o banco de dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=horta
DB_USER=user
DB_PASSWORD=

# Client ID do Google OAuth 2.0 para login com Google
GOOGLE_CLIENT_ID=

# Chave de API do Google Gemini para avaliação automática de comprovações de tarefas
GEMINI_API_KEY=

# Configurações do serviço de e-mail via SMTP (fallback quando BREVO_API_KEY não estiver configurada)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# URL pública do frontend para compor o link de recuperação de senha (HTTPS em prod ou localhost em dev)
PASSWORD_RESET_URL=http://localhost:3000/

# Chave da API HTTP do Brevo para envio transacional de e-mails (recomendado em produção / Railway)
BREVO_API_KEY=

# Origens autorizadas no CORS separadas por vírgula (ex.: https://meu-frontend.up.railway.app)
CORS_ORIGIN=

# Executar carga de dados de demonstração/seed no banco (opcional, padrão false, nunca habilitar em produção)
SEED_DEMO_DATA=false
